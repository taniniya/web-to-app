        <item>Android 8.0 (API 26)</item>
        <item>Android 10 (API 29)</item>
        <item>Android 12 (API 31)</item>
        <item>Android 14 (API 34)</item>
    </string-array>

    <string-array name="target_sdk_labels">
        <item>Android 14 (API 34) 最新</item>
        <item>Android 13 (API 33)</item>
        <item>Android 12 (API 31)</item>
    </string-array>

    <string-array name="orientation_labels">
        <item>自動回転（端末の設定に従う）</item>
        <item>縦画面に固定</item>
        <item>横画面に固定</item>
    </string-array>

    <!-- ビルド -->
    <string name="build_button">APKをビルドして書き出す</string>
    <string name="build_note">生成したAPKは署名済みです。完了後、そのままインストールできます</string>
    <string name="building">ビルド中…</string>
    <string name="build_done">✅ビルド完了</string>
    <string name="build_done_body">APK を生成しました (%1$s)</string>
    <string name="build_done_path">保存先: %1$s</string>
    <string name="build_failed">ビルドに失敗しました</string>
    <string name="install_now">今すぐインストール</string>
    <string name="share">共有</string>
    <string name="install_failed">インストーラーを開けませんでした</string>
