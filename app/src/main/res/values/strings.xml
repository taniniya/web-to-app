<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">WebToApp Studio</string>
    <string name="generator_title">web to apk</string>
    <string name="generator_subtitle">WebサイトのURL、またはHTML / CSS / JS ファイルからAndroidアプリをその場で生成します</string>

    <!-- モード -->
    <string name="label_mode">生成手段</string>
    <string name="mode_url">Webサイト (URL)</string>
    <string name="mode_file">ローカルファイル</string>

    <!-- URL モード -->
    <string name="hint_url">Webサイトのアドレス (URL)</string>
    <string name="hint_url_helper">例: example.com ／ https:// は自動で補います</string>
    <string name="paste">📋</string>
    <string name="error_url_required">URLを入力してください</string>
    <string name="label_offline">Webサイトをダウンロードしてオフライン化</string>
    <string name="offline_note">※正常に動作しない場合があります（外部APIやログインが必要なページなど）</string>
    <string name="offline_downloading">サイトをダウンロード中…</string>
    <string name="offline_done">オフライン化: %1$s</string>
    <string name="offline_failed">サイトをダウンロードできませんでした</string>
    <string name="offline_failed_hint">URLとネット接続を確認してください。ログインが必要なページはオフライン化できません。</string>

    <!-- ファイルモード -->
    <string name="pick_files">HTML / CSS / JS / ZIP を選択</string>
    <string name="no_files_selected">まだファイルが選ばれていません</string>
    <string name="file_mode_note">index.html を起点に、選んだファイルを全部アプリに同梱します（ZIPは自動で展開）。ネット接続なしで動きます。</string>
    <string name="error_files_required">HTMLファイルを選んでください</string>
    <string name="files_selected">✔ %1$dファイル選択中 (%2$s)</string>
    <string name="files_loading">読み込み中…</string>
    <string name="files_too_many">ファイルが多すぎます（最大%1$d個まで）</string>

    <!-- アプリ名 / パッケージ名 -->
    <string name="hint_name">アプリ名</string>
    <string name="hint_package">パッケージ名（自動入力・変更可）</string>
    <string name="error_name_required">アプリ名を入力してください</string>
    <string name="error_package_invalid">パッケージ名は com.example.app の形式で入力してください</string>

    <!-- アイコン -->
    <string name="label_icon">アイコン</string>
    <string name="pick_icon">画像を選択</string>

    <!-- 広告ブロック (Beta) -->
    <string name="label_adblock">広告ブロック (Beta機能)</string>
    <string name="adblock_note">※ベータ機能：一部のサイトでデザインが崩れる場合があります（標準ではオフ）</string>

    <!-- 詳細設定 -->
    <string name="label_advanced">⚙️ 詳細設定（対応Androidバージョン・画面の向きなど）</string>
    <string name="expand">開く ▼</string>
    <string name="collapse">閉じる ▲</string>
    <string name="label_min_sdk">最小対応Androidバージョン (minSdkVersion)</string>
    <string name="label_target_sdk">ターゲットバージョン (targetSdkVersion)</string>
    <string name="label_orientation">画面の向き</string>
    <string name="label_fullscreen">全画面表示（ステータスバーを隠す）</string>
    <string name="label_keep_screen_on">画面の常時点灯</string>
    <string name="label_zoom">拡大縮小（ピンチズーム）を許可</string>
    <string name="label_display">画面表示</string>
    <string name="label_pull_refresh">引っ張って更新（Pull to Refresh）</string>
    <string name="label_progress_bar">ページ読み込みの進捗バーを表示</string>
    <string name="label_desktop_mode">デスクトップ表示（PCモード）</string>
    <string name="label_dark_mode">ダークモード</string>
    <string name="label_output">APKの保存先</string>
    <string name="hint_apk_dir">保存先フォルダ名</string>
    <string name="default_apk_dir">WebToApp</string>
    <string name="apk_dir_helper">Download 内のフォルダ名。空欄なら Download 直下に保存します</string>
    <string name="apk_dir_note">※「MyApps」のように書くと Download/MyApps/ に保存します。「/」で区切って2階層まで指定できます。</string>

    <string-array name="dark_mode_labels">
        <item>自動（端末の設定に従う）</item>
        <item>常にダーク</item>
        <item>常にライト</item>
    </string-array>

    <string name="advanced_note">※最小対応バージョンを下げると、より古い端末でインストールできます。ターゲットバージョンは新しいほど最新のAndroidの振る舞いになります。</string>

    <string-array name="min_sdk_labels">
        <item>Android 5.0 (API 21) 推奨</item>
